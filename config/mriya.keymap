#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
          &kp ESC         &kp N1  &kp N2                  &kp N3     &kp N4     &kp N5         &kp N6       &kp N7         &kp N8     &kp N9         &kp N0    &kp EQUAL
&kp LWIN  &kp GRAVE       &kp Q   &kp W                   &kp E      &kp R      &kp T          &kp Y        &kp U          &kp I      &kp O          &kp P     &kp LBKT        &kp RIGHT_BRACKET
          &kp LEFT_SHIFT  &kp A   &kp S                   &kp D      &kp F      &kp G          &kp H        &kp J          &kp K      &kp L          &kp SEMI  &mt RSHIFT SQT
          &kp LCTRL       &kp Z   &kp X                   &kp C      &kp V      &kp B          &kp N        &kp M          &kp COMMA  &kp DOT        &kp FSLH  &mt RCTRL BSLH
                                  &mt LEFT_ALT LG(SPACE)  &lt 2 TAB  &kp SPACE  &lt 1 SPACE    &lt 1 ENTER  &kp BACKSPACE  &lt 2 DEL  &kp RIGHT_ALT
            >;
        };

        lower_layer {
            bindings = <
                &kp K_CALCULATOR  &none  &none   &none  &none   &none     &kp KP_NUMBER_0  &kp KP_DIVIDE    &kp KP_ASTERISK  &kp KP_MINUS     &kp LS(UNDERSCORE)  &kp MINUS
&kp KP_NUMLOCK  &none             &none  &none   &none  &none   &none     &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_PLUS      &none               &none            &kp PRINTSCREEN
                &kp LSHFT         &none  &none   &none  &none   &none     &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_DOT       &none               &kp RIGHT_SHIFT
                &trans            &none  &none   &none  &none   &none     &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_NUMBER_0  &none               &kp RCTRL
                                         &trans  &mo 3  &trans  &trans    &trans           &trans           &mo 3            &trans
            >;
        };

        raise_layer {
            bindings = <
        &trans     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5         &kp F6        &kp F7    &kp F8        &kp F9     &kp F10          &kp F11
&trans  &none      &none   &none   &none   &none   &none          &kp C_VOL_UP  &kp HOME  &kp UP_ARROW  &kp PG_UP  &kp INSERT       &none            &kp F12
        &kp LSHFT  &none   &none   &none   &none   &none          &kp C_MUTE    &kp LEFT  &kp UP        &kp RIGHT  &kp INS          &mt RCTRL K_APP
        &trans     &none   &none   &none   &none   &none          &kp C_VOL_DN  &kp END   &kp DOWN      &kp PG_DN  &kp PAUSE_BREAK  &kp RCTRL
                           &trans  &trans  &trans  &lt 3 SPACE    &lt 3 ENTER   &trans    &trans        &trans
            >;
        };

        adjust_layer {
            bindings = <
       &none        &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &none
&none  &bootloader  &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &bootloader  &none
       &bt BT_CLR   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
       &sys_reset   &none         &none         &none         &none         &none           &none         &none         &none         &none         &none         &sys_reset
                                  &none         &trans        &none         &trans          &trans        &none         &trans        &none
            >;
        };
    };
};
